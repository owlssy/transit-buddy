# TransitBuddy environment configuration
#
# 1. Copy this file to `.env` (or set values in app.json > expo.extra).
# 2. Get a free OneBusAway API key from https://pugetsound.onebusaway.org/ (or your regional OBA server).
# 3. Restart Expo after changing.
#
# All EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.

EXPO_PUBLIC_ONEBUSAWAY_API_KEY=
EXPO_PUBLIC_ONEBUSAWAY_BASE_URL=https://api.pugetsound.onebusaway.org
